{
  "manifest_version": 3,
  "name": "Notion Manager 账号导入助手",
  "version": "1.3.1",
  "description": "Extract Notion AI account config (token_v2, userId, spaceId) / 一键提取 Notion AI 账号配置",
  "permissions": [
    "cookies",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.notion.so/*",
    "https://*.notion.so/*",
    "https://notion.com/*",
    "https://*.notion.com/*",
    "http://127.0.0.1:8081/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
